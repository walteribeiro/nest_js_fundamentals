      "eslint-plugin-prettier": "^5.2.2",
      "globals": "^16.0.0",
      "prettier": "^3.4.2",
      "source-map-support": "^0.5.21",
      "supertest": "^7.0.0",
      "ts-loader": "^9.5.2",
